# Copiez ce fichier en .env (dans le dossier backend/) puis remplissez vos valeurs.

# ── Base de données PostgreSQL ──
DB_HOST=localhost
DB_PORT=5434
DB_NAME=smartcity
DB_USER=postgres
DB_PASSWORD=votre_mot_de_passe

# ── IA (OpenRouter) : https://openrouter.ai/keys ──
OPENROUTER_API_KEY=sk-or-v1-...
# Modèle gratuit (identifiant terminé par :free)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
